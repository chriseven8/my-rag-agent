# LLM / Embedding(OpenAI 兼容,默认 DashScope;换 OpenAI 改 base_url 即可)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v1
CHAT_MODEL=qwen-plus

# 向量库(docker-compose 起的 pgvector)
PG_CONNECTION_STRING=postgresql+psycopg2://rag:rag123456@127.0.0.1:5433/rag_db
SQLITE_PATH=data/rag.db

# 检索参数
VECTOR_MIN_SIMILARITY=0.45
KEYWORD_RELATIVE_SCORE_FLOOR=0.35
RRF_K=60
VECTOR_TOP_K=8
KEYWORD_TOP_K=8

# 证据预算
EVIDENCE_MAX_TOTAL_CHARS=4000
EVIDENCE_MAX_SNIPPET_CHARS=500

# 切块
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# mock 模式: 不配 API key 也能跑通入库+检索+问答(embedding/LLM 均为占位)
# 注意: mock↔真实 embedding 切换后,PG 里旧的向量集合(langchain_pg_embedding 表)要删掉重建,否则维度不匹配
EMBEDDING_MOCK=true
EMBEDDING_DIM=8
LLM_MOCK=true
